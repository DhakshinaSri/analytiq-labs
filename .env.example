# Optional. Copy this file to ".env" and fill in the values.

# Full public URL of the deployed site (no trailing slash). Used at build time
# to generate canonical tags, social tags and sitemap.xml for better SEO.
# Example: https://dhakshinasri.github.io/analytiq-labs
SITE_URL=

# Optional endpoint that receives the contact form (e.g. a Formspree URL).
# Example: https://formspree.io/f/xxxxxxxx
VITE_FORM_ENDPOINT=
